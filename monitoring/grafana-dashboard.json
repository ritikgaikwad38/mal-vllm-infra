{
  "title": "vLLM Inference — Mal Banking",
  "uid": "mal-vllm-dashboard",
  "timezone": "Asia/Dubai",
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Time To First Token (P99) — ms",
      "type": "timeseries",
      "description": "P99 TTFT — SLO target < 800ms",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, rate(vllm_time_to_first_token_seconds_bucket[5m])) * 1000",
          "legendFormat": "P99 TTFT (ms)"
        },
        {
          "expr": "histogram_quantile(0.95, rate(vllm_time_to_first_token_seconds_bucket[5m])) * 1000",
          "legendFormat": "P95 TTFT (ms)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": {
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "yellow", "value": 600 },
              { "color": "red", "value": 800 }
            ]
          }
        }
      }
    },
    {
      "id": 2,
      "title": "GPU/CPU Memory Utilization %",
      "type": "gauge",
      "description": "KV cache memory usage — alert at 90%",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 8 },
      "targets": [
        {
          "expr": "vllm_gpu_cache_usage_perc * 100",
          "legendFormat": "Memory Used %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "yellow", "value": 70 },
              { "color": "red", "value": 90 }
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "title": "Request Queue Depth",
      "type": "stat",
      "description": "Pending requests in vLLM queue",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 8 },
      "targets": [
        {
          "expr": "vllm_num_requests_waiting",
          "legendFormat": "Waiting Requests"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "yellow", "value": 5 },
              { "color": "red", "value": 10 }
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "title": "Requests Per Second",
      "type": "timeseries",
      "description": "Inference request throughput",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "rate(vllm_request_success_total[1m])",
          "legendFormat": "Successful req/s"
        },
        {
          "expr": "rate(vllm_request_failure_total[1m])",
          "legendFormat": "Failed req/s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        }
      }
    },
    {
      "id": 5,
      "title": "Tokens Generated Per Second",
      "type": "timeseries",
      "description": "vLLM token throughput",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "rate(vllm_generation_tokens_total[1m])",
          "legendFormat": "Tokens/sec"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      }
    },
    {
      "id": 6,
      "title": "Active vLLM Pods",
      "type": "stat",
      "description": "Running inference pods",
      "gridPos": { "x": 0, "y": 16, "w": 6, "h": 4 },
      "targets": [
        {
          "expr": "count(up{job='vllm-inference'} == 1)",
          "legendFormat": "Active Pods"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              { "color": "red", "value": 0 },
              { "color": "green", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "id": 7,
      "title": "Inter-token Latency P99 — ms",
      "type": "timeseries",
      "description": "Streaming smoothness metric",
      "gridPos": { "x": 6, "y": 16, "w": 12, "h": 4 },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, rate(vllm_inter_token_latency_seconds_bucket[5m])) * 1000",
          "legendFormat": "P99 Inter-token (ms)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        }
      }
    }
  ]
}